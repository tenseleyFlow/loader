/* Loader TUI Theme */

Screen {
    background: $surface;
}

/* Main layout — 4 rows: message area, approval bar (auto-hidden), input, status */
#main-container {
    layout: grid;
    grid-size: 1;
    grid-rows: 1fr auto 3 1;
}

#message-area {
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    padding: 1 2;
    background: $surface;
}

/* Input area */
#input-area {
    height: 3;
    border-top: solid $primary-darken-2;
    background: $surface-lighten-1;
    layout: horizontal;
}

#input-area .prompt {
    width: 3;
    content-align: center middle;
    color: $primary;
}

#input-area Input {
    border: none;
    background: transparent;
    width: 1fr;
}

#input-area Input:focus {
    border: none;
}

/* Status line */
StatusLine {
    height: 1;
    background: $surface-darken-1;
    padding: 0 2;
    content-align: left middle;
    color: $text-muted;
}

/* Tool widgets — height:auto so the colored border matches content */
ToolCallWidget {
    height: auto;
    max-height: 30;
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $accent;
}

ToolCallWidget > Static {
    height: auto;
}

ToolCallWidget.pending {
    border-left: thick $warning;
}

ToolCallWidget.error {
    border-left: thick $error;
}

ToolCallWidget.success {
    border-left: thick $success;
}

ToolCallWidget.running {
    border-left: thick $warning;
}

.tool-header {
    color: $primary;
}

.tool-summary {
    color: $text;
    padding-left: 2;
    margin-top: 0;
}

.tool-args {
    color: $text-muted;
}

.tool-toggle {
    background: transparent;
    border: none;
    color: $accent;
    padding: 0;
    margin-left: 2;
    min-width: 0;
    width: auto;
    height: 1;
    text-style: underline;
}

.tool-toggle:hover {
    background: transparent;
    color: $primary;
    text-style: bold underline;
}

.tool-toggle:focus {
    background: transparent;
    text-style: bold underline;
}

.tool-full-result {
    color: $text;
    padding-left: 2;
    margin-top: 1;
    border-left: solid $accent;
    padding: 0 0 0 1;
}

.tool-preview {
    color: $text;
    padding-left: 2;
    max-height: 6;
}

/* Diff widget */
DiffWidget {
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $accent;
}

.diff-header {
    color: $primary;
}

.diff-stats {
    color: $text-muted;
    padding-left: 2;
}

.diff-content {
    padding-left: 2;
}

.diff-added {
    background: #1a3d1a;
    color: #4ade80;
}

.diff-removed {
    background: #3d1a1a;
    color: #f87171;
}

.diff-context {
    color: $text-muted;
}

.diff-hunk {
    color: $secondary;
}

/* Streaming text */
StreamingText {
    padding: 0 1;
    margin: 0 0 1 0;
}

StreamingText.streaming {
    border-left: thick $warning;
}

/* User message */
.user-message {
    margin: 0 0 1 0;
    padding: 0 1;
}

/* Steering message */
.steering-message {
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $warning;
}

.user-label {
    color: $secondary;
    text-style: bold;
}

/* Assistant response */
.assistant-response {
    margin: 0 0 1 0;
    padding: 0 1;
}

/* Collapsible */
Collapsible {
    padding-left: 2;
    border: none;
    margin-top: 1;
}

CollapsibleTitle {
    color: $accent;
    text-style: underline;
    padding: 0 1;
}

CollapsibleTitle:hover {
    color: $primary;
    text-style: bold underline;
}

CollapsibleTitle:focus {
    color: $primary;
}

/* Plan widget */
.plan-container {
    margin: 0 0 1 0;
    padding: 1;
    border: round $primary;
}

.plan-header {
    color: $primary;
    text-style: bold;
}

.plan-content {
    padding: 1 0;
}

.step-progress {
    color: $warning;
    text-style: bold;
}

/* Reasoning widgets */
.decomposition-container {
    margin: 0 0 1 0;
    padding: 1;
    border: round $secondary;
    background: $surface-lighten-1;
}

.subtask-progress {
    margin: 0 0 1 0;
    padding: 0 1;
    color: $warning;
}

.confidence-assessment {
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $accent;
}

.critique-container {
    margin: 0 0 1 0;
    padding: 1;
    border-left: thick $warning;
    background: $surface-lighten-1;
}

.verification-success {
    margin: 0 0 1 0;
    padding: 0 1;
    color: $success;
}

.verification-failed {
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $error;
}

.completion-check {
    margin: 0 0 1 0;
    padding: 1;
    border: round $warning;
    background: $surface-lighten-1;
}

/* Rollback widgets */
.rollback-tracked {
    margin: 0 0 1 0;
    padding: 0 1;
    color: $text-muted;
}

.rollback-summary {
    margin: 0 0 1 0;
    padding: 1;
    border: round $secondary;
    background: $surface-lighten-1;
    color: $text-muted;
}
